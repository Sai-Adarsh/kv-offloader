function(check expected pattern)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "${expected}" OR NOT "${stdout}\n${stderr}" MATCHES "${pattern}")
        message(FATAL_ERROR "Unexpected result ${result} for ${ARGN}:\n${stdout}\n${stderr}")
    endif()
endfunction()

check(1 "usage:")
execute_process(COMMAND "${PROGRAM}" "" WORKING_DIRECTORY "${STATE_DIR}"
    RESULT_VARIABLE empty_directory_result ERROR_VARIABLE empty_directory_error)
if(NOT empty_directory_result STREQUAL "1" OR NOT empty_directory_error MATCHES "spill directory must not be empty")
    message(FATAL_ERROR "Expected an empty spill directory to be rejected: ${empty_directory_error}")
endif()
check(1 "unknown kv_offloader flag" "${STATE_DIR}" --bad)
check(1 "numeric option outside" "${STATE_DIR}" --disk-slots 1)
check(1 "numeric option outside" "${STATE_DIR}" --churn 1x)
check(0 "checksum_ok=true" "${STATE_DIR}")
check(0 "disk_high_water_bytes=262144 disk_budget_bytes=262144" "${STATE_DIR}" --disk-slots 4 --churn 16)
check(0 "disk_high_water_bytes=131072 disk_budget_bytes=131072" "${STATE_DIR}" --disk-slots 2 --churn 16)
if(DIRECT_IO)
    check(0 "direct_io=1.*checksum_ok=true" "${STATE_DIR}" --direct)
    check(0 "checksums_ok=true" "${STATE_DIR}" --direct --disk-slots 2 --churn 16)
endif()
if(NOT CUDA_ENABLED)
    check(1 "rebuild with ENABLE_CUDA=ON" "${STATE_DIR}" --gpu)
endif()
